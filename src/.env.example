APP_NAME=Localizarr
TZ=UTC
PORT=5005
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=
API_KEY=
NODE_ENV=development
SESSION_DRIVER=cookie
DB_CONNECTION=sqlite
PROXY_PORT=5006

# Ollama AI Processing Configuration
# Set to 'false' to disable LLM-based title analysis and processing
ENABLE_OLLAMA_PROCESSING=true

# Ollama AI Server Configuration
# Host where Ollama server is running (default: host.docker.internal for Docker)
OLLAMA_HOST=host.docker.internal
# Port where Ollama server is listening (default: 11434)
OLLAMA_PORT=11434
# Model to use for LLM analysis (default: gemma3:4b)
OLLAMA_MODEL=gemma3:4b