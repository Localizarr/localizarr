{
  "name": "localizarr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "npx tsx bin/server.ts",
    "build": "npm run build:ts",
    "build:ts": "tsc --project tsconfig.json",
    "dev": "npx tsx bin/server.ts",
    "test": "npm run test:prepare && env NODE_ENV=test node ace test unit",
    "test:prepare": "node ace migration:run --connection=memory --force",
    "test:functional": "npm run test:prepare && env NODE_ENV=test node ace test functional",
    "test:all": "npm run test:prepare && env NODE_ENV=test node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "reset:db": "node ace migration:rollback && node ace migration:run",
    "migr": "node ace migration:run --force",
    "seed": "node ace db:seed",
    "import:titles": "node ace import:titles",
    "import:titles:force": "node ace import:titles:force",
    "test:cover:unit": "c8 npm run test",
    "test:cover:functional": "c8 npm run test:functional",
    "test:cover:all": "c8 npm run test:all",
    "coverage:report": "c8 report --reporter=html"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@adonisjs/eslint-config": "^2.0.0",
    "@adonisjs/prettier-config": "^1.4.4",
    "@adonisjs/tsconfig": "^1.4.0",
    "@japa/api-client": "^3.1.0",
    "@japa/assert": "^4.0.1",
    "@japa/plugin-adonisjs": "^4.0.0",
    "@japa/runner": "^4.2.0",
    "@swc/core": "1.11.24",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.15.18",
    "@types/supertest": "^6.0.3",
    "@types/wait-on": "^5.3.4",
    "eslint": "^9.26.0",
    "hot-hook": "^0.4.0",
    "nock": "^14.0.10",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.4",
    "ts-node-maintained": "^10.9.6",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3",
    "wait-on": "^9.0.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^9.4.0",
    "@adonisjs/core": "^6.18.0",
    "@adonisjs/cors": "^2.2.1",
    "@adonisjs/lucid": "^21.6.1",
    "@adonisjs/session": "^7.5.1",
    "@adonisjs/shield": "^8.2.0",
    "@adonisjs/static": "^1.1.1",
    "@types/cheerio": "^0.22.35",
    "@vinejs/vine": "^3.0.1",
    "axios": "^1.12.2",
    "better-sqlite3": "^12.4.1",
    "change-case": "^5.4.4",
    "cheerio": "^1.1.2",
    "csv-parser": "^3.2.0",
    "fast-xml-parser": "^5.3.0",
    "https-proxy-agent": "^7.0.6",
    "luxon": "^3.7.2",
    "node-fetch": "^3.3.2",
    "ollama": "^0.6.0",
    "reflect-metadata": "^0.2.2",
    "vue": "^3.5.22"
  },
  "hotHook": {
    "enabled": false
  },
  "prettier": "@adonisjs/prettier-config"
}
